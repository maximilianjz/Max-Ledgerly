# Use Ledgerly's production account API key. Keep all values server-side.
WHOP_API_KEY=
# Optional existing payout account. New sellers are selected from the registry.
WHOP_ACCOUNT_ID=
# Required for the seller onboarding flow.
WHOP_PLATFORM_ACCOUNT_ID=
WHOP_ENVIRONMENT=production
LEDGERLY_DATA_DIR=.data/ledgerly

# Primary database. For compose.yaml, use the local development URL below.
# DATABASE_URL=postgresql://ledgerly:ledgerly_development@127.0.0.1:5432/ledgerly
# Hosted deployments should use their provider's pooled PostgreSQL URL with TLS.
DATABASE_URL=

# Legacy Redis configuration, retained for existing deployments during cutover.
# DATABASE_URL takes precedence; failures never fall back to Redis or files.
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted. Keep eviction disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use the same namespace in the app and CLI; use a different one for preview deployments.
LEDGERLY_STORAGE_NAMESPACE=ledgerly-v1

# Optional live webhook configuration; keep separate from local fixtures.
# Connected-account hook: /api/webhooks/whop, child_resource_events=true.
WHOP_WEBHOOK_SECRET=
# Parent-account hook: /api/webhooks/whop/parent, child_resource_events=false.
WHOP_PARENT_WEBHOOK_SECRET=

# An origin only, without a path. Use your HTTPS origin when hosting.
# The complete hosted seller flow uses persistent storage configured above.
APP_URL=http://localhost:3000
