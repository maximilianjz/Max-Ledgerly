# Use Ledgerly's production account API key. Keep all values server-side.
WHOP_API_KEY=
# Optional existing payout account. New sellers are selected from the registry.
WHOP_ACCOUNT_ID=
# Required for the seller onboarding flow.
WHOP_PLATFORM_ACCOUNT_ID=
WHOP_ENVIRONMENT=production
LEDGERLY_DATA_DIR=.data/ledgerly

# Required on Vercel: connect Upstash Redis in the project's Storage tab.
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted if the integration uses those names.
# Keep eviction disabled. No record expiration is set by this app.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use the same namespace in the app and CLI; use a different one for preview deployments.
LEDGERLY_STORAGE_NAMESPACE=ledgerly-v1

# Optional live webhook configuration; keep separate from local fixtures.
WHOP_WEBHOOK_SECRET=

# An origin only, without a path. Use your HTTPS origin when hosting.
# The complete hosted seller flow uses the Redis connection above.
APP_URL=http://localhost:3000

# npm run setup generates a random local password and session secret.
# Set separate strong values on your host. Password: at least 20 characters.
ASSESSMENT_PASSWORD=
SESSION_SECRET=
