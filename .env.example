# Use Ledgerly's production account API key. Keep all values server-side.
WHOP_API_KEY=
# Optional existing payout account. New sellers are selected from the registry.
WHOP_ACCOUNT_ID=
# Required for the seller onboarding flow.
WHOP_PLATFORM_ACCOUNT_ID=
WHOP_ENVIRONMENT=production
LEDGERLY_DATA_DIR=.data/ledgerly

# Optional live webhook configuration; keep separate from local fixtures.
WHOP_WEBHOOK_SECRET=

# An origin only, without a path. Use your HTTPS origin when hosting.
# The complete seller flow also needs persistent storage (see README).
APP_URL=http://localhost:3000

# npm run setup generates a random local password and session secret.
# Set separate strong values on your host. Password: at least 20 characters.
ASSESSMENT_PASSWORD=
SESSION_SECRET=
